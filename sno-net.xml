    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr1' stp='on' delay='0'/>
  <ip address='192.168.123.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.123.2' end='192.168.123.254'/>
      <host mac="02:01:00:00:00:66" name="node.sno.ocp.dev" ip="192.168.123.5"/>
    </dhcp>
  </ip>
  <dnsmasq:options>
    <dnsmasq:option value="address=/sno.ocp.dev/192.168.123.5"/>
  </dnsmasq:options>
</network>
